# ===========================================
# Auth.js Configuration
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the Next.js app (used for logout redirect)
AUTH_URL=http://localhost:3000

# Keycloak OIDC Provider — used by foundation-web client
AUTH_KEYCLOAK_ID=foundation-web
AUTH_KEYCLOAK_SECRET=foundation-web-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/abdullah-foundation

# ===========================================
# Keycloak Admin API (server-side only)
# ===========================================
# Uses Keycloak's built-in "admin-cli" client from the master realm.
# This is NOT a second application client — it's Keycloak's own internal
# client for administrative operations. It ships with every Keycloak
# installation and lives in the master realm.
#
# foundation-web = our OIDC client for user login (abdullah-foundation realm)
# admin-cli     = Keycloak's built-in client for Admin API (master realm)
#
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
